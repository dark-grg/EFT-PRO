{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eft-pro",
  "main": "worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WHEEL_DO",
        "class_name": "WheelDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WheelDurableObject"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
