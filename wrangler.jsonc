{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eft-pro",
  "main": "worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WHEEL_DO",
        "class_name": "WheelDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WheelDurableObject"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eft-pro-db",
      "database_id": "eft-pro-db-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "eft-pro-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WHEEL_STORE",
      "id": "wheel_store_id"
    },
    {
      "binding": "PLAYERS_STORE",
      "id": "players_store_id"
    },
    {
      "binding": "PLAYER_DEVELOPMENTS_STORE",
      "id": "player_developments_store_id"
    }
  ],
  "observability": {
    "enabled": true
  }
}
